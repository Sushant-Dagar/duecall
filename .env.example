# LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound phone calls: a LiveKit outbound SIP trunk (e.g. backed by Twilio or Exotel)
SIP_OUTBOUND_TRUNK_ID=

# Model providers
STT_PROVIDER=deepgram          # deepgram | google
LLM_PROVIDER=google            # google (Gemini) | openai (GPT) | anthropic (Claude)
LLM_MODEL=                     # optional override, e.g. gemini-2.5-flash, gpt-4o-mini
TTS_PROVIDER=cartesia          # cartesia | google
TTS_VOICE=

DEEPGRAM_API_KEY=
GOOGLE_API_KEY=                # Gemini
CARTESIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json   # only for Google STT/TTS

PROMPT_VERSION=v2
LEDGER_PATH=data/ledger.db
